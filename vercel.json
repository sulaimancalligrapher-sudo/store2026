{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets|src/assets|pwa-|apple-touch-icon|icon\\.svg|manifest|sw\\.js|workbox-).*)",
      "destination": "/index.html"
    }
  ]
}
